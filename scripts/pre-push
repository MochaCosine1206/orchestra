#!/usr/bin/env bash
# pre-push hook for Claude Orchestra (B-165)
# Checks if documentation is stale relative to code changes since last push.
# Only flags docs that are likely affected by the specific code changes.
# Skip with SKIP_DOC_CHECK=1 git push.

set -euo pipefail

# Allow skipping with SKIP_DOC_CHECK=1 git push
if [ "${SKIP_DOC_CHECK:-0}" = "1" ]; then
  exit 0
fi

# Color codes (skip if not a terminal)
if [ -t 1 ]; then
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  GREEN='\033[0;32m'
  RESET='\033[0m'
else
  YELLOW='' CYAN='' GREEN='' RESET=''
fi

# Read stdin for remote/url info (standard pre-push hook protocol)
while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip delete pushes
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Determine the range of commits being pushed
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New branch: compare against merge-base with dev or main
    base=$(git merge-base HEAD dev 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo "")
    if [ -z "$base" ]; then
      continue
    fi
    range="${base}..${local_oid}"
  else
    range="${remote_oid}..${local_oid}"
  fi

  # Get files changed in the push range
  changed_files=$(git diff --name-only "$range" 2>/dev/null || true)
  if [ -z "$changed_files" ]; then
    continue
  fi

  # Classify code changes by area
  has_cmd_changes=false
  has_orchestrator_changes=false
  has_agent_changes=false
  has_db_changes=false
  has_tui_changes=false
  has_monitor_changes=false
  has_schema_changes=false
  has_new_files=false
  code_files=()

  while IFS= read -r file; do
    case "$file" in
      internal/cmd/*|cmd/*)
        has_cmd_changes=true
        code_files+=("$file")
        ;;
      internal/orchestrator/*)
        has_orchestrator_changes=true
        code_files+=("$file")
        ;;
      internal/agent/*)
        has_agent_changes=true
        code_files+=("$file")
        ;;
      internal/db/*|*.sql)
        has_db_changes=true
        code_files+=("$file")
        ;;
      internal/tui/*)
        has_tui_changes=true
        code_files+=("$file")
        ;;
      internal/monitor/*)
        has_monitor_changes=true
        code_files+=("$file")
        ;;
      templates/*)
        code_files+=("$file")
        ;;
      *.go)
        code_files+=("$file")
        ;;
    esac
  done <<< "$changed_files"

  # Check for new files (additions) — these are more likely to need doc updates
  new_files=$(git diff --name-only --diff-filter=A "$range" 2>/dev/null || true)
  if [ -n "$new_files" ]; then
    while IFS= read -r file; do
      case "$file" in
        internal/*|cmd/*|*.go)
          has_new_files=true
          ;;
      esac
    done <<< "$new_files"
  fi

  code_count=${#code_files[@]}
  if [ "$code_count" -eq 0 ]; then
    continue
  fi

  # Map code areas to relevant docs
  # Only flag docs that are likely affected by the specific changes
  relevant_docs=()

  # CHANGELOG.md — always relevant when code changes
  relevant_docs+=("CHANGELOG.md")

  # GO-SPEC.md — CLI flags, command structure, project structure, new files
  if [ "$has_cmd_changes" = true ] || [ "$has_new_files" = true ]; then
    relevant_docs+=("GO-SPEC.md")
  fi

  # CLAUDE.md — architectural decisions, major new features, workflow changes
  # Only flag for significant changes (new files, orchestrator changes, or many files)
  if [ "$has_new_files" = true ] || [ "$code_count" -ge 5 ]; then
    relevant_docs+=("CLAUDE.md")
  fi

  # BACKLOG.md — when implementing features that may correspond to backlog items
  if [ "$has_orchestrator_changes" = true ] || [ "$has_agent_changes" = true ] || [ "$has_new_files" = true ]; then
    relevant_docs+=("BACKLOG.md")
  fi

  # SPEC.md — only for architectural changes (new packages, new patterns)
  if [ "$has_new_files" = true ] && [ "$code_count" -ge 8 ]; then
    relevant_docs+=("SPEC.md")
  fi

  # GAPS.md — only when closing gaps (orchestrator + agent changes together)
  if [ "$has_orchestrator_changes" = true ] && [ "$has_agent_changes" = true ] && [ "$has_new_files" = true ]; then
    relevant_docs+=("GAPS.md")
  fi

  # README.md — only for user-facing CLI changes or new commands
  if [ "$has_cmd_changes" = true ] && [ "$has_new_files" = true ]; then
    relevant_docs+=("README.md")
  fi

  # Check which relevant docs were NOT updated
  stale_docs=()
  updated_docs=()
  for doc in "${relevant_docs[@]}"; do
    if echo "$changed_files" | grep -q "^${doc}$"; then
      updated_docs+=("$doc")
    else
      stale_docs+=("$doc")
    fi
  done

  # Deduplicate (bash arrays can have dupes)
  if [ ${#stale_docs[@]} -gt 0 ]; then
    stale_docs=($(printf '%s\n' "${stale_docs[@]}" | sort -u))
  fi
  if [ ${#updated_docs[@]} -gt 0 ]; then
    updated_docs=($(printf '%s\n' "${updated_docs[@]}" | sort -u))
  fi

  # Report
  stale_count=${#stale_docs[@]}
  updated_count=${#updated_docs[@]}

  if [ "$stale_count" -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}--- Documentation Staleness Check (B-165) ---${RESET}"
    echo -e "${CYAN}${code_count} code file(s) changed in this push.${RESET}"
    if [ "$updated_count" -gt 0 ]; then
      echo -e "${GREEN}Updated:${RESET} ${updated_docs[*]}"
    fi
    echo -e "${YELLOW}Potentially stale:${RESET}"
    for doc in "${stale_docs[@]}"; do
      echo "  - $doc"
    done
    echo ""
    echo "Update these docs before pushing, or skip with:"
    echo "  SKIP_DOC_CHECK=1 git push"
    echo -e "${YELLOW}----------------------------------------------${RESET}"
    echo ""
    push_blocked=1
  fi
done

if [ "${push_blocked:-0}" = "1" ]; then
  exit 1
fi

exit 0
