      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)"
    ]
  }
}
